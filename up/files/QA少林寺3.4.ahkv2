;@@點擊答案
MC_Click(ctrl,*){
    if ctrl.ok
        ToolTip "✅ 正確"
    else
        ToolTip "❌ 錯誤"
}

Shuffle(arr){
    Loop arr.Length{
        r:=Random(A_Index,arr.Length)
        tmp:=arr[A_Index]
        arr[A_Index]:=arr[r]
        arr[r]:=tmp
    }
}





;@ 上一題 < fx ---PrevQA(*)
PrevQA(*){
    global curDB, curIdx, L_lv
    if !curDB.Length
        return
    curIdx := curIdx<=1 ? curDB.Length : curIdx-1
    ShowQA(curIdx)
    L_lv.Modify(curIdx, "Select Focus Vis")
}

;@ 下一題 > fx ---NextQA()
NextQA(*){
    global curDB, curIdx, L_lv
    if !curDB.Length
        return
    curIdx := curIdx >= curDB.Length ? 1 : curIdx + 1
    ShowQA(curIdx)
    L_lv.Modify(curIdx,"Select Focus Vis")
}


;@ 發音
;@@ 發音1 ---內建 Microsoft Speech API speakInt()
speakInt(txtEng){
    static sp:=ComObject("SAPI.SpVoice")
    sp.Speak(txtEng, 1)
}  ;speakInt("dominant")

;@@ 發音2a ---googleTTS()
googleTTS(txtEng){
;Run("https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=en&q=" txtEng)
    static wmp := ComObject("WMPlayer.OCX")
    if (Trim(txtEng) = "")
    return
    encodedTxt := UriEncode(txtEng)
    wmp.URL := "https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=en&q=" encodedTxt
    wmp.controls.play()
}


;@@ 發音3 ---世界真人錄音發音humanSp
userSp(txtEng){
    Run("https://forvo.com/word/" txtEng "/")
}




; 發音2b ---googleTTS() input text 轉碼用
UriEncode(str) {
    buf := Buffer(StrPut(str, "UTF-8") - 1)
    StrPut(str, buf, "UTF-8")
    res := ""
    loop buf.Size {
        byte := NumGet(buf, A_Index - 1, "UChar")
        if (byte >= 0x30 && byte <= 0x39) || (byte >= 0x41 && byte <= 0x5A) || (byte >= 0x61 && byte <= 0x7A) || byte = 0x2D || byte = 0x5F || byte = 0x2E || byte = 0x7E
            res .= Chr(byte)
        else
            res .= Format("%{:02X}", byte)
    }
    return res
}





;@ 智慧中英混排斷行 fx ----WrapText(str, maxW := 36)
; ==================================================
; 智慧中英混排斷行函數（中文字寬=2、英數字寬=1、不切斷英文單詞、換行補4空格）
; 呼叫函數：設定每行最大視覺寬度為 36（1個中文字=2，1個英數字=1）
; result := WrapText(txt0, 36)
; ==================================================
WrapText(str, maxW := 36) {
    out := ""
    for line in StrSplit(str, "`n", "`r") {
        curW := 0
        pos := 1
        while (pos <= StrLen(line)) {
            if RegExMatch(line, "([A-Za-z0-9\-/]+|.)", &m, pos) {
                token := m[0]
                pos += StrLen(token)
                
                tokW := 0
                loop parse, token
                    tokW += (Ord(A_LoopField) > 127) ? 2 : 1
                
                if (curW > 0 && curW + tokW > maxW) {
                    out .= "`n    "
                    curW := 4
                    token := LTrim(token)
                    tokW := StrLen(token)
                }
                out .= token
                curW += tokW
            }
        }
        out .= "`n"
    }
    return RTrim(out, "`n")
}












