;@ ━━━━━━━━━━ [行3]-功能區 ━━━━━━━━━━
;@@---------左-題目目錄-----------

;@@【左-btn-加題(&A)】按鈕
guiMain0.AddButton("section x" gMagX0 " w" L_lvBtnW " h" btnH, "+題(&A)").OnEvent("Click", openTxt)
openTxt(*) {
    global
    if (orgLoc := FileSelect(1, fileLoc "\Eng")) {
        IniWrite(orgLoc, iniFile, "set0", "currOpen")    ; 寫入 ini
        orgTxt .= FileRead(orgLoc, "UTF-8") "`n"
        ; 判斷檔名類型並執行對應處理
        srcTyp := SubStr(orgLoc, -8, 5)
        fileNmeTypeOpen(srcTyp)
    }
}



;@@【左-btn-源文件txt】按鈕
openSource:=guiMain0.AddButton("ys xp+" L_lvBtnW " w" L_lvBtnW " h" btnH,"源txt(&S)")   ;📄

    openSource.OnEvent("Click",(*)=>FileExist(orgLoc)?Run(orgLoc):(ToolTip("文件不存在"),SetTimer(()=>ToolTip(),-1500)))
;@@【左-btn-新題庫(&N)】按鈕
nwDB:=guiMain0.AddButton("ys xp+" L_lvBtnW " w" L_lvBtnW " h" btnH,"新(&N)")
