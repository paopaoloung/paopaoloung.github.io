cbTips.OnEvent("Click",(*)=>(IniWrite(cbAns.Value,iniFile,"set0","showTips"),ShowQA(curIdx)))

;@@ Checkbox---✅答案
cbAns := guiMain0.AddCheckbox("ys x+0" ck(iniSet0["showAns"]),"答案")
cbAns.OnEvent("Click",(*)=>(IniWrite(cbAns.Value,iniFile,"set0","showAns"),ShowQA(curIdx)))

;@@ Checkbox---✅反轉QA
cbRev := guiMain0.AddCheckbox("ys x+0" ck(iniSet0["revQA"]),"QA反🔃")
cbRev.OnEvent("Click",(*)=>(IniWrite(cbRev.Value,iniFile,"set0","revQA"),ShowQA(curIdx)))

;@@ Checkbox---✅[隨機題目]
cbRandom := guiMain0.AddCheckbox("ys x+0", "隨機")
cbRandom.Value := iniSet0["randomQ"]
cbRandom.OnEvent("Click", RandomFx)

;@@ Checkbox---✅聲音
cbSound := guiMain0.AddCheckbox("ys x+0" ck(iniSet0["sound"]), "聲音")
cbSound.OnEvent("Click", cbSoundFx)
    cbSoundFx(*){
    IniWrite(cbSound.Value, iniFile, "set0", "sound")
    googleTTS(editQ.Value)
    }

;@@ [tab]---tabNme：["QA","單選"...]
tab:=guiMain0.AddTab3("Buttons ys h" btnH " w" tabW,tabNme)
tab.UseTab(0)


;@@ ComboBox---倒計時 cbBoxS
cbBoxS:=guiMain0.AddComboBox("ys x+0 w" ini["editTimerW"], ["5","10","15","20",])
    cbBoxS.Text := 0
dnTime:=guiMain0.AddText("ys x+0", " (s) ")    ;down Time
dnTime.OnEvent("Click", dnTime_Click)
dnTime.OnEvent("DoubleClick", dnTime_DblClick)
  pTick := 0
  dnTime_Click(*) {
    global pTick
    tt0:="`n    ● 暫停/恢复計時    `n    ● 雙擊重置`n    "
    pTick := !pTick
    if pTick {
    SetTimer(UpdateProg, 0)      ; 暫停
    ToolTip(tt0), SetTimer(ToolTip, -2000)
     } else {
    SetTimer(UpdateProg, 1000)   ; 恢復
    ToolTip(tt0), SetTimer(ToolTip, -2000)
    }
}
sOld:=""
  dnTime_DblClick(*) {
  global count, prog, cbBoxS, sOld
    if (cbBoxS.Text != "0") {    ; 0 如改為"0"不能自動執行計時器
       sOld := cbBoxS.Text
       count := 0
       prog.Value := 0
       cbBoxS.Text:=0
    SetTimer(UpdateProg, 0)          ; 歸零並停止
    } Else {
    cbBoxS.Text := sOld
    tCountDnFx(cbBoxS)
    }
}


;@@ btn---[重啟]
guiMain0.AddButton("x+10 h"  btnH, "重啟(r)").OnEvent("Click", (*) => Reload())

;@@ btn---[發聲]
