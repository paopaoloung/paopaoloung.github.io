;@@ start
MonitorGetWorkArea(, &l, &t, &r, &b)    ; 探測視窗大小
scale := A_ScreenDPI / 96                         ; 取得當前螢幕 DPI 縮放倍率 (例如 150% 縮放)
    monW := (r - l) / scale                           ; 將物理像素換算為邏輯像素
    monH := (b - t) / scale

iniSet:="A_ComputerName"

db       := []    ;保存QA題庫
curDB  := []    ;暫存-目前使用的題庫
 optCtl := []    ;單選題MC 的數組A/B/C/D/E
 orgLoc := ""      ;開啟檔案---儲存位置
 orgTxt  := "`n"   ;開啟檔案---儲存的內容
curIdx   := 0       ;當前題號

;@@ 初始生成各種資料夾
fileLoc   := A_ScriptDir "\QALib"    ;總QAdb
engLib   := fileLoc "\Eng"
clinicLib := fileLoc "\clinicalStudy"
  helpLoc := "QALib\help.txt"
  helpTxt  := FileRead(helpLoc, "UTF-8")

    for v in [fileLoc,engLib,clinicLib]            ;不存在則建立
    DirExist(v) || DirCreate(v)

iniFile:=fileLoc "\QASetting.ini"                                  ;生成初始 ini 設定



;@ QASetting.ini 
;----------------------預設定 ini-----------------------
iniTxt:="
(
;通用設定 --------iniSet0["fontSize"]
[set0]
fontSize=14
revQA=0
showAns=1
showTips=1
randomQ=0
sound=1

;家用電腦設定----- ini["guiW"]
[TABLET-NEMJVN0G]
guiW=1200
guiH=700
gMarginx=10
;三欄中間分隔--寬度=gMarginx/2
T_tabBtnW=70

;中間 tab
M_tabW=600
M_tabH=500

;所有按鈕-高度
btnH=30
editTimerW=50


[GUI_desktop]
guiW=1200
guiH=700
gMarginx=10
T_tabBtnW=80
;三欄中間分隔--寬度=gMarginx/2

;中間 tab
M_tabW=600
M_tabH=500

;所有按鈕-高度
btnH=30
editTimerW=50
)"
;-------------------- /預設定 ini/ ---------------------

FileExist(iniFile) || FileAppend(iniTxt,iniFile,"UTF-8")    ;有則忽略，無則新建寫入

;@ 讀取 ini 裡的所有設定
;@@ 通用設定 -------------iniSet0["fontSize"]
iniSet0:=Map()
for z in StrSplit(IniRead(iniFile,"set0"),"`n","`r"){
    x:=StrSplit(z,"=")
    if x.Length=2
    iniSet0[x[1]]:=x[2]
}

;@@ 調取電腦名稱設定 ---ini["guiW"]
ini:=Map()
    txt := IniRead(iniFile, A_ComputerName, , "")
    if (txt = "")
    txt := IniRead(iniFile, "GUI_desktop", , "")

for z in StrSplit(txt, "`n", "`r"){
    x := StrSplit(z, "=")
    if x.Length = 2
    ini[x[1]] := x[2]
}

; 使用計時
startTick := A_TickCount
  pauseTick := 0
  pauseMs := 0



;@----------ctrlSize----------
;@@ 控件左邊界------gMagX0
;@@ 標準按鈕高度----btnH
    gMagX0 := ini["gMarginx"]
    btnH       := ini["btnH"]


;@@ [tab]---tabNme=選項卡-項目["QA卡片", "單選"] -- 寬-tabW 
    tabNme := ["QA卡片", "單選"]
    tabW       := Floor(ini["T_tabBtnW"]*tabNme.Length)      ;------top tab寬

    tsGoingX   := Floor(ini["guiW"]*0.8)                                       ;------經過時間---x座標

;@@["5","10","15","20",]S 倒計時寬度 ----ini["editTimerW"]

;@ 左ListView 寬度 -----------L_lvW ------gMagX0*3=左右邊界+中間間隔*2(等於1個邊界)
    L_lvW      := (ini["guiW"]-gMagX0*3-ini["M_tabW"])/2
;@ 中間功能窗之間分隔寬 ---tabGap
    tabGap    := gMagX0/2                 ;-------------tab 內中間間隔寬=左邊界/2
    L_lvBtnW := L_lvW/3                     ;-------------左最上3個按鈕--寬

;@ 左ListView 高度 ------------L_lvH
    L_lvH := ini["M_tabH"]-btnH

;@ 中 QAT 問題 edit 控件寬 ---tabInW
tabInW := ini["M_tabW"]-ini["gMarginx"]
;@ 行3 中間 tab 總寬 --------- ini["M_tabW"] = editQ寬+tabGap*2



;@ ▇▇▇▇▇▇▇▇▇▇[Gui]▇▇▇▇▇▇▇▇▇▇
guiMain0 := Gui("+Resize", "QA少林寺")
guiMain0.SetFont("s" iniSet0["fontSize"], "Verdana")

;@ ━━━━━━━━━━ [行1] ━━━━━━━━━━
;@@ Menu-檔案 -子菜單
mFile:=Menu()
mFile.Add("打開題庫`tCtrl+O", OpenFile)
mFile.Add("保存結果`tCtrl+S", SaveFile)
mFile.Add()
mFile.Add("退出", (*)=>ExitApp)

OpenFile(*){
}

SaveFile(*){
}

;@@ Menu-工具
mTool:=Menu()
mTool.Add("📂源文件題目生成", (*)=>0)

;@@ Menu-模式選擇
mGen:=Menu()
mGen.Add("模式1 - QA卡片", (*)=>0)
mGen.Add("模式2 - 單選題", (*)=>0)

;@@ Menu-幫助
mHelp:=Menu()
mHelp.Add("使用說明", (*)=>0)
mHelp.Add("關於", (*)=>0)
;@@-------------------------

;@@行1---[檔案、工具、幫助、...]
mb:=MenuBar()
mb.Add("檔案",mFile)
mb.Add("工具",mTool)
mb.Add("模式選擇",mGen)
mb.Add("幫助",mHelp)
mb.Add("📂",(*)=>Run(fileLoc))

mb.Add("📌",pinGui)
        pinGui(*) {
        static top := 0
        guiMain0.Opt((top := !top) ? "+AlwaysOnTop" : "-AlwaysOnTop")
        top ? ToolTip("最上層鎖定！🔒") : ToolTip("取消鎖定...🔓")
        SetTimer(ToolTip, -1500)
        }

mb.Add("🌀",(*)=>Reload())

mb.Add("❔",readme)
    readme(*){
    if FileExist(helpLoc)
    Run(helpLoc)
    }
guiMain0.MenuBar:=mb



ck(v){
return v?" Checked":""
}


;@━━━━━━━━━━ [行2] ━━━━━━━━━━
;@@ Checkbox---✅筆記
