guiMain0.AddStatusBar()
guiMain0["msctls_statusbar321"].SetText("Ready...")

y0:=Floor((monH - ini["guiW"])/2)-200    ;初始主窗 y 顯示位置
guiMain0.Show("xcenter w" ini["guiW"] " h" ini["guiH"] " y" y0)


