global editW:=200
global x0 := 0, y0 := 0
;@ GUI---代碼輸入
;═════════════ [代碼輸入] ═════════════
    myGui := Gui("-MinimizeBox -MaximizeBox +AlwaysOnTop", "inpbx")
    myGui.SetFont("s12", "Microsoft JhengHei") 
    myGui.Add("Text", "", "請輸入捷徑代碼：")
    editCtrl := myGui.Add("Edit", "section r1 w" editW)

    btnOK:=myGui.Add("Button", "y+2 w" editW/2, "OK").OnEvent("Click", RunCommand)
    btnX:=myGui.Add("Button", "x+2 yp w" editW/2, "關閉").OnEvent("Click", (*) => myGui.Hide())
    myGui.OnEvent("Close", (*) => myGui.Hide())
    myGui.OnEvent("Escape", (*) => myGui.Hide())



;@ GUI---藍色小窗口  按中鍵出錯
;blueWin("倒計時 2s 關閉！", 5)
;blueWin("點文字關閉！", 0)
blueWin(txtTip, duration) {
    global GuiTip0, txt0, txt1, t1, t
    t := duration
    t1 := duration
    
    if WinExist("[GuiTip]") {
        txt0.Value := txtTip
        txt1.Value := t1 "s"
        SetTimer tDn, 1000
        sleep duration * 1000
        return
    }

    GuiTip0 := Gui("+AlwaysOnTop -Caption +Border +Owner", "[GuiTip]")
    GuiTip0.BackColor := "Aqua"

    GuiTip0.SetFont("s15 w1000", "norm")
    txt0 := GuiTip0.Add("Text", "x5 y5 R1", txtTip).OnEvent("Click", (*) => GuiTip0.Hide())
    ;點擊文字可關閉---for不倒計時關閉的窗口
    txt1 := GuiTip0.Add("Text", "x+10 w50", t1 "s")
    
    SetTimer tDn, 1000
    GuiTip0.Show("NoActivate AutoSize")
;WinSetTransparent 70, "[GuiTip]"
    if t == 0 {
    SetTimer tDn, 0
    txt1.value := ""					;不自動消失窗口
    return
    }

    sleep duration * 1000
    
    SetTimer tDn, 0
    GuiTip0.Hide()
}

tDn(*) {
    global t1, t, txt1
    t1--
    if (t1 < 0) {
        t1 := t
    } 
    try txt1.Value := t1 "s"
}



;@ [左鍵+右鍵] ---呼叫剪貼板菜單(#!=)
;LButton & RButton::Send("#!=")
;@ [左鍵+滾↑] ---聲音調校：增大聲音
~LButton & WheelUp::Send("{Volume_Up}")
;@ [左鍵+滾↓] ---聲音調校：減小聲音
~LButton & WheelDown::Send("{Volume_Down}")


;@ [中鍵] ---窗口置頂//  
~MButton:: {
    CoordMode("Mouse", "Screen"), MouseGetPos(&x, &y, &id)
    if id && WinExist("ahk_id " id) {
        ; 0x84 是 WM_NCHITTEST，用於測試鼠標在窗口中的位置
        res := SendMessage(0x84, 0, (x & 0xFFFF) | ((y & 0xFFFF) << 16), , id)
        
        ; res == 2 代表鼠標當前正處於窗口的標題欄 (HTCAPTION)
        if (res == 2) {
            WinSetAlwaysOnTop(-1, id)
            blueWin("窗口置頂！", 5) ; 提示函數移到這裡，只有觸發置頂時才顯示
        }
    }
}

