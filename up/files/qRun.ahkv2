;@ [LCtrl & LWin] ---中文輸入
~LCtrl & LWin::SwitchLanguage(0x4040404, 1)    ;0英 / 1中



;@ [Win+V] ---貼上檔案的路徑
#v::{
txt := A_Clipboard
if InStr(txt, "出处：bilibili") {
    txt := StrReplace(txt, "作者：", "|")
    txtArray := StrSplit(txt, "|")
    A_Clipboard := txtArray[1]
}
txt := StrReplace(txt, "`n", "")      ; 移除換行符
txt := StrReplace(txt, "`r", "")                      ; 移除換行回車符
txt := StrReplace(txt, A_Tab, A_Space)       ; 將 Tab 鍵全替換為半形空格
A_Clipboard := txt
Sleep 500
Send("^v")
}




;@ [Escape] * 2 ---关闭窗口
~Esc:: {
  if KeyWait("Escape", "T0.5") && KeyWait("Escape", "D T0.2")
  WinClose("A")
}



;@ [Alt+1] ---繁簡轉換：to 簡體
!1:: {
    send "^c"
    Sleep 500
    ClipWait(1)
    Text := A_Clipboard
    ; 呼叫 Windows API 進行繁轉簡
    Length := DllCall("LCMapStringW", "UInt", 0x0800, "UInt", 0x02000000, "Str", Text, "Int", -1, "Ptr", 0, "Int", 0)
    
    if (Length > 0) {
        VarSetStrCapacity(&Buffer, Length * 2)
        DllCall("LCMapStringW", "UInt", 0x0800, "UInt", 0x02000000, "Str", Text, "Int", -1, "Str", Buffer, "Int", Length)
        A_Clipboard := Buffer
        sleep 500
        Send("^v")
    }
}


;@ [Alt+2] ---繁簡轉換：to 繁體
!2:: {
    send "^c"
    Sleep 500
    ClipWait(1)

    Text := A_Clipboard
    ; 💡 關鍵修改：將 0x02000000 改為 0x04000000 (LCMAP_TRADITIONALCHINESE)
    Length := DllCall("LCMapStringW", "UInt", 0x0800, "UInt", 0x04000000, "Str", Text, "Int", -1, "Ptr", 0, "Int", 0)
    
    if (Length > 0) {
        VarSetStrCapacity(&Buffer, Length * 2)
        DllCall("LCMapStringW", "UInt", 0x0800, "UInt", 0x04000000, "Str", Text, "Int", -1, "Str", Buffer, "Int", Length)
        A_Clipboard := Buffer
        Sleep(500)
        Send("^v")
    }
}





;@ [Alt+Space] ---⬛代碼輸入窗口
;@ 熱字串：---dmsr⬛代碼輸入窗口
::dmsr::
!space::
openInpbx(*) {
global x0, y0, btn1w, btn1h
CoordMode("Mouse", "Client")
  editCtrl.Value:=""
  UserInput := ""

myGui.Show()
MouseMove x0, y0, 0
editCtrl.Focus()
sleep 100
;@@設為英文輸入法
SwitchLanguage(0x4040404, 0)
;@@獲取OK按扭的位置---將滑鼠移至其中心點
if (x0==0 && y0==0){
;surfacePro8 有DPI縮放，ControlGetPos適用
ControlGetPos &btn1x, &btn1y, &btn1w, &btn1h, "Button1", "inpbx"
;msgbox btn1x "---" btn1y

;！標準電腦沒有縮放的，探AHK自己劃的Gui會更精準
;myGui["OK"].GetPos(&btn1x, &btn1y, &btn1w, &btn1h)
;msgbox btn1x "---" btn1y
    x0 := btn1x + (btn1w / 2)
    y0 := btn1y + (btn1h/2)
    MouseMove x0, y0, 0
}
}



;@ #HotIf WinActive("inpbx")
#HotIf WinActive("inpbx")
Enter::
NumpadEnter::

RunCommand(*) {
;Global

  UserInput := editCtrl.Value
  iniR := IniRead("inputBoxRun.ini", "run", UserInput, "xxx")
  myGui.Hide()

;@@ 功能： inpbx ---⬛UserInput 分析
switch UserInput {
    case "np":  Run("notepad")        ; txt筆記本
    case "hh":  Run("mspaint")        ; 畫畫
    case "fdj": Run("magnify")        ; 放大鏡
    case "jsj": Run("calc")        ; 放大鏡
    case "yy":  Send("#h")            ; 語音輸入

    case "fw":  Run("services.msc")   ; 本地服務管理
    case "zj":  Run("comexp.msc")     ; 組件/元件服務
    case "zz":  Run("devmgmt.msc")    ; 裝置管理員
    case "dx":  Run("dxdiag")         ; directX診斷工具

    case "dy":  Run("powercfg.cpl")   ; 電源計劃
    case "lx":  Run("ncpa.cpl")             ; 網路連線
    case "xsq": Run("desk.cpl")       ; 顯示器設定
    case "ly":  Run("bthprops.cpl")   ; 藍牙設定
    ;case "edini":  Run('"' EmEditorLoc '" "' A_ScriptDir '\inputBoxRun.ini"')
    case "eds":  Run('"' EmEditorLoc '" "' A_ScriptFullPath '"')


    case "ccx":   ; 清除剪貼簿
        Send("#!=")
        if WinWait("ahk_exe CLCL.exe", , 3) { ; 加上 3 秒超時保護，防止視窗沒出現時程式卡死
            Sleep(500)
            Send("h")
            Sleep(500)
            Send("y")
            blueWin("清除剪貼薄---完成！", 2)
        }

    case "reg": ; 打開注冊表並跳轉到剪貼簿路徑
        if WinExist("注册表编辑器 ahk_class RegEdit_RegEdit") {
            WinClose()
            WinWaitClose()
        }
        
        ; 處理剪貼簿中的路徑斜線（v2 標準 StrReplace 預設就是替換全部）
        cleanPath := StrReplace(A_Clipboard, "＼", "\")
        cleanPath := StrReplace(cleanPath, "/", "\")
        RegWrite(cleanPath, "REG_SZ", "HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Applets\Regedit", "LastKey")
        Run("regedit.exe")
}



    default:
    if (UserInput == "" || iniR == "xxx")
    return
    else {
    iniR:=StrReplace(iniR, "[user0]", A_UserName)
    }
    Run(iniR)
}


