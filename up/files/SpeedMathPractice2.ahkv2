edW := 60    ;edit控件寬度


;@菜單：右click---設置頁
rClickMenu := Menu()
rClickMenu.Add("[...范圍取值...]", rClickFx)
rClickMenu.Add("(...數學運算...)", rClickFx)
rClickMenu.Add("(...10-A 補數 ...)", rClickFx)
    rClickFx(ItemName, ItemPos, TargetMenu) {
    A_Clipboard := ""
    Send("^a")
    Sleep 500
    Send("^x")
    Sleep 500

    switch ItemName{
    case "[...范圍取值...]":
        SendInput("[" A_Clipboard "]")
    case "(...數學運算...)":
        SendInput("(" A_Clipboard ")")
    case "(...10-A 補數 ...)":
        SendInput("(10-" A_Clipboard ")")
    default:
        tooltip "未設定..."
}
    }


ShowRkMenu := (*) => rClickMenu.Show()




