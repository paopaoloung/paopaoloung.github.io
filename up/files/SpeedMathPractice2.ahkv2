; ==============================================================================
; 邏輯與運算核心
; ==============================================================================
;@OnGenerateClick---功能：點擊「生成題目並跳轉」
OnGenerateClick(*) {
    GenerateNewProblem(editA.value, editB.value, editC.value, editD.value)
    Tab.Choose(3)  
    editAns.Focus() 
}





;@GenerateNewProblem---功能：生成問題
GenerateNewProblem(a0, b0, c0, d0) {
Global

numA:=genNum(a0)
numB:=genNum(b0)
numC:=genNum(c0)
numD:=genNum(d0)

num1:=numA . numB
num2:=numC . numD

txtProblem.value := numA . numB . " ❌ " . numC . numD . " = "
;ans := Random(0, 1) ? "A" : "B"
txtProblem.value := Random(0, 1) ? num1 . " ❌ " . num2 . " = " : num2 . " ❌ " . num1 . " = "

}



;@genNum---功能：Edit控件A、B、C、D產生數值
genNum(x0) {
Global
  x0:=StrReplace(x0, " ", "",,, -1)      ;取代所有空格


;@@;留空時---生成隨機整數
  if (x0==""){
  Num:=Random(1, 9)
  }

;@@句式含A、B、C、D時代數取代
x0:=StrReplace(x0, "A", numA)
x0:=StrReplace(x0, "B", numB)
x0:=StrReplace(x0, "C", numC)
x0:=StrReplace(x0, "D", numD)

  if (IsInteger(x0)){
  Return x0
  }



;@@含開括號"(" ➕➖❌➗的運算
  if InStr(x0, "(") {
  x0:=RegExReplace(x0, "[\(\)]", "")       ;刪除括號

  calA:=StrSplit(x0, "+", ".")                   ;以+號分隔數值，忽略句点. txt_s[1]
  if (calA.Length==2)
  Num:=calA[1] + calA[2]

  calA:=StrSplit(x0, "-", ".")
  if (calA.Length==2)
  Num:=calA[1] - calA[2]

  calA:=StrSplit(x0, "*", ".")
  if (calA.Length==2)
  Num:=calA[1] * calA[2]

  calA:=StrSplit(x0, "/", ".")
  if (calA.Length==2)
  Num:=calA[1] / calA[2]

  }


;@@含開括號"[" ➕➖❌➗的運算
  if InStr(x0, "[") {
  x0:=RegExReplace(x0, "[\[\]]", "")       ;刪除[]
  calA:=StrSplit(x0, "-", ".")                    ;以-號分隔數值，忽略句点. txt_s[1]
  if (calA.Length==2)
  Num:=Random(calA[1], calA[2])
  }

Return Num
  }












;@OnAnsEnter---功能：答案框按下 Enter 鍵觸發核對
OnAnsEnter(*) {
    global

    userAns := Trim(editAns.Value)
    if (userAns == "") {
        userAns := "0" 
    }
    
    numAB := (numA * 10) + numB
    numCD := (numC * 10) + numD
    correctResult := numAB * numCD
    
    isCorrect := (Integer(userAns) == correctResult)
    resultSuffix := isCorrect ? " 對！" : " 錯x" . "----" . correctResult
    
    editAnsTxt.Value := txtProblem.value . userAns . resultSuffix
    
    if (isCorrect) {
        editAnsTxt.SetFont("cGreen")
    } else {
        editAnsTxt.SetFont("cRed")
    }

;@@下一題---產生新問題
    GenerateNewProblem(editA.value, editB.value, editC.value, editD.value)
    editAns.Focus()
}




;@#HotIf WinActive(...) ---Enter
#HotIf WinActive("ahk_id " MyGui.Hwnd)
NumpadEnter::
Enter:: {
Global
focused := MyGui.FocusedCtrl
if (focused == editA || focused == editB || focused == editC || focused == editD) {
  Tab.Choose(3) ; 跳轉到練習頁
  OnGenerateClick()
  editAns.Focus()
  }

Else if (focused == editAns)
OnAnsEnter()
}


$RButton:: {
    MouseGetPos , , , &ctrlHwnd, 2
    if (ctrlHwnd = editA.Hwnd || ctrlHwnd = editB.Hwnd || ctrlHwnd = editC.Hwnd || ctrlHwnd = editD.Hwnd) {
      rClickMenu.Show()
    }
    else
    Send("{RButton}")

}

#HotIf








; 視窗關閉時退出程式
GuiClose(*) {
    ExitApp()
}


