::omnn::例
::omwm::僵屍
::rji::戰
::srln::剧
::tehr::落
::tmd::某
::vfnau::絶
::vid::樂
::yrpa::詢





;~Esc::exit0()
exit0(*){
ToolTip "【" A_ScriptName "】關閉ing..."
sleep 2000
ExitApp
}