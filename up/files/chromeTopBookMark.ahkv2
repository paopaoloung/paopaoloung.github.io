

#Requires AutoHotkey v2.0
#SingleInstance Force

TraySetIcon("shell32.dll", 44)
MouseMove 0, 0 , 0, "R"                       ;如刪除，在別處點左鍵menu不消失

/*---------------------------------
　　• topBar右鍵---➕調用新增窗口
　　• topBar Ctrl + 左鍵：抓取你畫面上目前 Chrome 的新網址，直接覆蓋並
　　   替換掉這個項目的舊網址（標題名稱保持不變）。
　　• topBar Shift + 左鍵：刪除此選單項目與 INI 紀錄。

    • Ctrl + NumpadAdd (數字鍵+): 快速將當前網頁一鍵加入（不跳GUI），並檢查是否重複。
---------------------------------*/

;@設定：全域變數與 INI 檔案（使用 UTF-16 確保中文不亂碼）
; -----------------------------------------------------------------------------
iniFile := "BookmarkSettings.ini"
sectionName := "topBarBookMark"    ;統一使用的 Section 名稱

myMenu := Menu()
;myMenu.SetColor("FFFFAA")
x0 := 0
y0 := 0

; 初始化 INI 檔案（如果不存在，建立為 UTF-16 格式）
if !FileExist(iniFile) {
    fileObj := FileOpen(iniFile, "w", "UTF-16")       ;W-寫入
    fileObj.Close()                                                   ;必須馬上把檔案關閉並存檔才不會被佔用
}
; -----------------------------------------------------------------------------


;@1. 動態構建選單
BuildDynamicMenu()                                               ;開局執行1次
BuildDynamicMenu() {
;    global myMenu, iniFile, sectionName
;    try myMenu.Delete()    ; 清空舊選單，避免重複疊加

;@生成主菜單---myMenu
    myMenu.Add("➕ (shift-刪除／Ctrl-更新／Ctrl+: 快速加入)", MenuAction_Add)
    myMenu.Add() ; 加入分隔線

    ; 從 INI 檔案的 [topBarBookMark] 段落讀取所有已儲存的 標題=網址 紀錄
    try {
        iniContent := IniRead(iniFile, sectionName) ; 直接讀取該區塊的所有行
        if (iniContent != "") {
            Loop Parse, iniContent, "`n", "`r" {
                if (A_LoopField != "") {
                    ; 拆分 標題 與 網址
                    equalPos := InStr(A_LoopField, "=")

                    if (equalPos > 0) {                                                     ;有=號時
                        title := StrSplit(A_LoopField, "=")[1]                     ;獲取 ini key name 等號分隔第1個
 
;@●前綴設定
                       if RegExMatch(A_LoopField, "https?://")               ;●網業菜單
                        myMenu.Add("● " title, MenuAction_OpenURL)
                        else if InStr(A_LoopField, ".ahk")                           ;⚪ahk菜單
                        myMenu.Add("🛠 " title, MenuAction_OpenURL)
                        else
                        myMenu.Add("◉ " title, MenuAction_OpenURL)  ;生成菜單
                    }

                }
            }
        }
    }  ;//try
;OnMessage(0x0006, WM_ACTIVATE.Bind(myMenu))
}    ;//BuildDynamicMenu() 


; 消息處理函數：當窗口失去焦點時自動隱藏
WM_ACTIVATE(guiObj, wp, lp, msg, hwnd) {
    ; wp == 0 表示窗口正在被停用（失去焦點）
    if (wp == 0 && hwnd == guiObj.Hwnd) {
        guiObj.Hide()
    }
}


;@位置判斷：滑鼠是否在螢幕最頂部
CoordMode("Mouse", "Screen")
IsMouseOnTopEdge() {
Global
MouseGetPos(&x0, &y0)
return (y0 < 2)                      ;如果符合，則 IsMouseOnTopEdge:=True
}


;@功能：獲取 Chrome 的網址 + 背景保護剪貼簿
GetChromeURL() {
Global
    if !WinActive("ahk_exe chrome.exe")
    WinActivate "ahk_exe chrome.exe"

    oldClipboard := ClipboardAll()
    A_Clipboard := ""

    Send "^l"
    Sleep 150
    Send "^c"
    Sleep 500
    Send "{Esc}" 

   url := A_Clipboard
   A_Clipboard := oldClipboard
}



;@1. 點擊 [按鈕➕] --- 功能：抓取網業標題及網址，彈出編輯框
MenuAction_Add(ItemName, ItemPos, MyMenu) {
    sleep 200
    titleA := WinGetTitle("A")
    titleA := RegExReplace(titleA, " - Google Chrome\$")
    GetChromeURL()
    ShowEditGui(titleA, url)
}

;@2. [菜單項目]---功能：Shift 刪除Key、Ctrl 覆蓋網址
MenuAction_OpenURL(ItemName, ItemPos, MyMenu) {
    ;global iniFile, sectionName
    ; 移除選單裝飾用的圓點，還原出純標題
;@●取消前綴
    iniSection := RegExReplace(ItemName, "^[●◉🛠]\s*")          ;取消前綴


;@@[Ctrl + 左鍵] ---功能：覆蓋更新網址
    if GetKeyState("Ctrl", "P") {
    GetChromeURL()            ;url=活動網址

    result := MsgBox(Format("【{}】網址覆蓋/更新：`n`n{}", iniSection, url), "覆蓋確認", "YesNo Icon?")
    if (result == "Yes") {
      IniWrite(url, iniFile, sectionName, iniSection)     ;更新指定的 Key
      ToolTip("已成功覆蓋網址！`n項目：" iniSection)
      SetTimer(() => ToolTip(), -1500)
      }
        return
    }  ;//if GetKeyState("Ctrl", "P")


;@@[Shift + 左鍵] ---功能：刪除該書籤
    if GetKeyState("Shift", "P") {
        result := MsgBox("刪除：`r`n`r`n【" iniSection "】", "刪除確認", "YesNo Iconx")
        if (result == "Yes") {
          ;刪除 [topBarBookMark] 底下對應的 Key，而不是刪除整個 Section
          IniDelete(iniFile, sectionName, iniSection)
          ToolTip("已成功刪除：`n" iniSection)
          SetTimer(() => ToolTip(), -1500)
        }

    myMenu.Delete()              ; 清空舊菜單
    BuildDynamicMenu()        ; 重新生成菜單
    return
    }  ;//if GetKeyState("Shift", "P")
    
;@@[Menu一般點擊] ---功能：直接開啟網址/軟件
    ;讀取 [topBarBookMark] 底下該標題對應的網址
    urlB := IniRead(iniFile, sectionName, iniSection)
;@@@開網址
    if (urlB != "" && InStr(urlB, "http")) {
      if WinExist("ahk_exe chrome.exe") {
      WinActivate("ahk_exe chrome.exe")
      Run('chrome.exe "' urlB '"')
      Return
      }
    }

;@@@開軟件
    Else
    Run urlB
}








;@[Ctrl + Numpad➕] --- 功能：快速加入記錄
QuickAddCurrentPage() {
    GetChromeURL()
    iniContent := IniRead(iniFile, sectionName)
    Loop Parse, iniContent, "`n", "`r" {
       if (A_LoopField != "") {
           equalPos := InStr(A_LoopField, "=")
                if (equalPos > 0) {
                  existingTitle := SubStr(A_LoopField, 1, equalPos - 1)    ;截取=號前面內容
                  existingUrl   := SubStr(A_LoopField, equalPos + 1)       ;截取=號後面全部內容
                }
       }
    }

    ;獲取標題並清理字尾
    titleA := WinGetTitle("A")
    titleA := RegExReplace(titleA, " - Google Chrome$")
    titleA := Trim(titleA)

    ;未能獲取窗口名稱時---有序命名
    if (titleA == "")
    titleA := "未命名分頁_" A_TickCount

    ;防止標題中含有 "=" 符號破壞 INI 結構，進行安全替換
    titleA := StrReplace(titleA, "=", "-")

    ;寫入 INI（Key=標題，Value=網址）並核對成功提示
    IniWrite(url, iniFile, sectionName, titleA)

    ; 再次讀取核對是否成功寫入
    checkUrl := IniRead(iniFile, sectionName, titleA, "")
    if (checkUrl == url) {
       myMenu.Delete()    ; 清空舊選單，避免重複疊加
       BuildDynamicMenu()
       ToolTip("✨ 快速加入成功！`n標題：" titleA)
        SetTimer(() => ToolTip(), -2500)
        }

}  ;//QuickAddCurrentPage()---[Ctrl + Numpad➕] --- 功能：快速加入記錄


;@[Ctrl + Numpad➕] ---快捷鍵：快速加入並核對
^NumpadAdd::QuickAddCurrentPage()



;@#HotIf IsMouseOnTopEdge() ---判斷滑鼠是否在最頂部
;只有當滑鼠 Y 座標 < 2 時，點擊右鍵才會觸發選單
#HotIf IsMouseOnTopEdge()

;@[RButton]---快捷鍵：打開主菜單
RButton:: {
sleep 200
Send("{Esc}")
myMenu.Show()
}


;@#HotIf
#HotIf








ShowEditGui(titleA, urlB) {
    myGui := Gui("+AlwaysOnTop", "新增書籤")
    myGui.SetFont("s14", "Microsoft JhengHei")
    
    myGui.Add("Text",, "網頁名稱 (Key):")
    editTitle := myGui.Add("Edit", "w400 vTitle", titleA)

    myGui.Add("Text",, "網址 (Value)：")
    myGui.Add("Edit", "w400 vUrl ReadOnly", urlB)
    
    btnSave := myGui.Add("Button", "w100 x150 y+15 Default", "確定")
    btnSave.OnEvent("Click", (btn, info) => OnSave(myGui, urlB))
    myGui.Show()
}

OnSave(guiObj, originalUrl) {
    global iniFile, sectionName
    savedData := guiObj.Submit()
    finalTitle := Trim(savedData.Title)
    
    if (finalTitle == "") {
        MsgBox("標題不能為空！", "錯誤", "Icon!")
        return
    }
    
    ; 防止標題中的 "=" 破壞 INI 結構
    finalTitle := StrReplace(finalTitle, "=", "-")
    
    try {
        ; 方案二：以標題為 Key，網址為 Value
        IniWrite(originalUrl, iniFile, sectionName, finalTitle)
        ToolTip("儲存成功！")
        SetTimer(() => ToolTip(), -1500)
    } catch {
        MsgBox("儲存失敗。", "錯誤", "Icon!")
    }
}






    screenWidth := A_ScreenWidth
    screenHeight := A_ScreenHeight
    centerX := screenWidth // 10*9
    centerY := screenHeight // 3

;@#HotIf WinActive-------抖音
; -----------------------------------------------------------------------------
; 抖音專用快捷鍵區（只有當抖音視窗活動時才生效）
; -----------------------------------------------------------------------------
#HotIf WinActive("抖音")
Numpad0::sdKey("j")                     ; J 清屏
Numpad5::sdKey("h")                     ; H 全屏
NumpadDot::sdKey("f")                 ; F 進入作者主頁
NumpadSub::sdKey("r")                   ; ➖感興趣
Down::sdKey("{WheelDown 4}")            ; ↓ 滾動畫面

;NumpadDot::sdKey("u")                   ; ●小窗口
;NumpadAdd::sdKey("c")                  ; ➕收藏

; 設定快速鍵（這裡以 F4 為例，可改為其他按鍵如 F1, ^m 等）
sdKey(keyToSend, *){
    MouseMove(centerX, centerY, 0)
    sleep 100
    Send(keyToSend)
}

