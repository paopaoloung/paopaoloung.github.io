;探測視窗大小
MonitorGetWorkArea(, &l, &t, &r, &b)
; 取得當前螢幕的 DPI 縮放倍率 (例如 150% 縮放時，scale 為 1.5)
scale := A_ScreenDPI / 96
; 將物理像素換算為邏輯像素
monW := (r - l) / scale
monH := (b - t) / scale


iniSet:="A_ComputerName"
;readmeTxt := FileRead("QALib\原始文件\help.txt", "UTF-8")


~Esc::{
  ToolTip "reloading..."
  sleep 1500
  Reload
}

~^Esc::{
  ToolTip "Exiting..."
  sleep 1500
  ExitApp
}

