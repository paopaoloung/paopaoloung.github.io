;@@ tab.OnEvent---Change
tab.OnEvent("Change", OnTabChg)
OnTabChg(ctrl, info) {
    ; 1. 先執行原本的控件顯示/隱藏切換
    tabCtrls(ctrl.Value, tabGroups)
    
    ; 2. 判斷是否點擊了第 1 個分頁 ("QA卡片")
    if (ctrl.Value = 1) {
        global orgTxt
        engQA(orgTxt)
    }

    ; 3. 判斷是否點擊了第 2 個分頁 ("MC")
    if (ctrl.Value = 2) {
        global orgTxt
        MCQdb(orgTxt)
    }

}

;tab.Value := 2    顯示第 tab 2組控件
tabCtrls(1, tabGroups)    ;預設顯示第1組控件

