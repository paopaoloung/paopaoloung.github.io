;@ [tab控件] ---自動切換各組控件的顯示狀態 (tabCtrls)
tabCtrls(activeIndex, groups) {
for pageIndex, ctrlList in groups {
    isVisible := (pageIndex = activeIndex)
    for ctrl in ctrlList
      ctrl.Visible := isVisible
    }
}



;@ 亂序 fx ---RandomFx(ctrl, *)
    RandomFx(ctrl, *) {
    global
    iniSet0["randomQ"] := ctrl.Value
    IniWrite(ctrl.Value, iniFile, "set0", "randomQ")

    ; 記錄目前題目
    oldQ := curDB.Length ? curDB[curIdx]["Q"] : ""

    ; 重建 curDB
    curDB := qaDB.Clone()

    if ctrl.Value
    {
        Loop curDB.Length
        {
            r := Random(A_Index, curDB.Length)
            tmp := curDB[A_Index]
            curDB[A_Index] := curDB[r]
            curDB[r] := tmp
        }
    }

    ; 重建 ListView
    L_lv.Delete()
    for i, v in curDB
        L_lv.Add("", i, v["Q"])

    ; 找回原題目
    curIdx := 1
    if oldQ
        for i, v in curDB
            if (v["Q"] = oldQ) {
                curIdx := i
                break
            }

    ShowQA(curIdx)
    L_lv.Modify(curIdx, "Select Focus Vis")
}



SetTimer(UpdateTime, 1000)
UpdateTime()
txtTime_Click(*){
    global pauseTick, pauseMs
    if pauseTick {
        pauseMs += A_TickCount - pauseTick
        pauseTick := 0
        SetTimer(UpdateTime, 1000)
        txtTimeSymb.Value:="▶"
    } else {
        pauseTick := A_TickCount
        SetTimer(UpdateTime, 0)
        txtTimeSymb.Value:="⏸"
    }
}






;@ • 解析orgTxt ---QA
engQA(txt, *) {
/*-----------------
anima
n. 灵魂、灵气
#:
拆词：anima → 爱你妈（谐音）
记忆：要爱你的妈妈，是她给了你生命

dominant
adj. 占优势的
#:
拆词：dominant → 都没男的（谐音）
记忆：这里除了我以外都没有男的，说明我是有优势的
...
    • qatTxt：整題原文
    • q：問題
    • a：答案（第 2 行到最後一行）
    • t：筆記（#: 後全部內容）
    • qaDB：整個題庫陣列（避免和局部變量 qa 混名）
-----------------*/
global

    qaDB := []
    curDB := []
    L_lv.Delete()

    txt := StrReplace(txt, "`r`n`r`n", "$")

    for qatTxt in StrSplit(txt, "$")
    {
        if !qatTxt
            continue

        qatTxt := StrReplace(qatTxt, "#:`r`n", "$")

        x := StrSplit(qatTxt, "$")
        r := StrSplit(Trim(x[1]), "`n", "`r")

        q := Trim(r[1])
        t := x.Length > 1 ? Trim(x[2]) : ""

        a := ""
        Loop r.Length - 1
            a .= (a ? "`n" : "") Trim(r[A_Index + 1])

        if q
            qaDB.Push(Map("Q", q, "A", a, "T", t))
    }

    curDB := qaDB.Clone()

    ; 隨機且不重複
    if cbRandom.Value
    {
        Loop curDB.Length
        {
            r := Random(A_Index, curDB.Length)
            tmp := curDB[A_Index]
            curDB[A_Index] := curDB[r]
            curDB[r] := tmp
        }
    }

    ; 重建 ListView
    L_lv.Delete()

    for i, v in curDB
        L_lv.Add("", i, v["Q"])

    if !curDB.Length
        return

    curIdx := 1
    ShowQA(1)
}



;@ • 解析orgTxt ---MCQdb()
MCQdb(txt, *) {
Global mcDB


p1 := "答案："             ;切隔問題+選擇ABCDE // 答案+解析
p2 := "解析："             ;切隔答案+解析

txt:=StrReplace(txt,"`r`n`r`n`r`n","$")

for qotTxt in StrSplit(txt,"$") {           ;---question, option, tips

    qot := StrSplit(qotTxt, p1, "`r")

    if qot.Length=2 {

        qo := qot[1]        ;問題question+選擇option:ABCDE
        at := qot[2]        ;answer+Tip

        l := StrSplit(at, p2)

        if l.Length!=2
    continue

        RegExMatch(l[1], "([A-E])", &m)
        ans := m[1]                                    ;-----------答案 A~E
        tip := Trim(l[2])                             ;-----------解釋 t
        p3 := "m)^\s*\(?A[\.\)]?\s*"          ;用選擇A切隔問題 // 選擇ABCDE

        if p:=RegExMatch(qo, p3) {
    Qtion := Trim(SubStr(qo, 1, p-1))      ;------question
    optA2E := Trim(SubStr(qo, p))          ;-----------選擇option A-E

    oa:=ob:=oc:=od:=oe:=""
    for s in StrSplit(optA2E,"`n","`r") {
        s:=Trim(s)
        if !s
            continue
        if RegExMatch(s,"^\(?A[\.\)]?\s*(.*)",&m)
            oa:=m[1]
        else if RegExMatch(s,"^\(?B[\.\)]?\s*(.*)",&m)
            ob:=m[1]
        else if RegExMatch(s,"^\(?C[\.\)]?\s*(.*)",&m)
            oc:=m[1]
        else if RegExMatch(s,"^\(?D[\.\)]?\s*(.*)",&m)
            od:=m[1]
        else if RegExMatch(s,"^\(?E[\.\)]?\s*(.*)",&m)
            oe:=m[1]

    } ;//for s in StrSplit(optA2E,"`n","`r")

    ;入庫
    mcDB.Push(Map(
        "Q",Qtion,
        "O",[
            [ans="A",oa],
            [ans="B",ob],
            [ans="C",oc],
            [ans="D",od],
            [ans="E",oe]
        ],
        "T",tip
    ))

        } ;//if p:=RegExMatch(qo,p3)
    } ;//if qot.Length=2
} ;//for qotTxt in StrSplit(txt,"$")

;測試
;MsgBox mcDB.Length
;MsgBox "1" mcDB[1]["Q"]
;MsgBox mcDB[1]["O"][3][2]
;MsgBox mcDB[1]["T"]

} ;//MCQdb(txt, *)




;@ 倒計時 fx---UpdateProg()
UpdateProg() {
    global t, count, prog, cbBoxS
    if (--count < 0) {
        NextQA()
        tCountDnFx(cbBoxS) ; 重新開始倒數
        return
    }
    prog.Value := Round(count * 100 / t)
}


cbBoxS.OnEvent("Change", tCountDnFx)
t:=0,count:=0
tCountDnFx(ctrl, *) {
global t, count, prog
    if (ctrl.Text = "" || ctrl.Text <= 0) {
        count := 0
        prog.Value := 0
        SetTimer(UpdateProg, 0)
        return
    }
    t := Integer(ctrl.Text)
    count := t
    prog.Value := 100
    SetTimer(UpdateProg, 0)
    SetTimer(UpdateProg, 1000)
}




;@ 顯示題目 fx ---ShowQA(idx)
ShowQA(idx){
global
    if !curDB.Length
        return
    curIdx := idx
    q := cbRev.Value ? curDB[curIdx]["A"] : curDB[curIdx]["Q"]
    a := cbRev.Value ? curDB[curIdx]["Q"] : curDB[curIdx]["A"]
    editQ.Value := q
    editA.Value := cbAns.Value ? a : ""
    editT.Value := cbTips.Value ? curDB[curIdx]["T"] : ""
    txtPos.Value := Format("題目 {:02}/{:02}：", curIdx, curDB.Length)

    ;QA模式時要同時隱藏第2欄（題目）
    if (cbAns.Value = 0 && tab.Value = 1)
    L_lv.ModifyCol(1, L_lvW)
    else
    L_lv.ModifyCol(1, 40) 



    if cbSound.Value {
    googleTTS(q)
    tCountDnFx(cbBoxS)
    }
}

;@!!!!!!!!!! 刷新題庫 fx ---RefreshLV()
RefreshLV(){
    global curDB, L_lv
    L_lv.Opt("-Redraw")
    L_lv.Delete()
    for i,v in curDB
    L_lv.Add("",i,v["Q"])
    L_lv.Opt("+Redraw")
}

;@ 上一題 < fx ---PrevQA(*)
PrevQA(*){
    global curDB, curIdx, L_lv
    if !curDB.Length
        return
    curIdx := curIdx<=1 ? curDB.Length : curIdx-1
    ShowQA(curIdx)
    L_lv.Modify(curIdx, "Select Focus Vis")
}

;@ 下一題 > fx ---NextQA()
NextQA(*){
    global curDB, curIdx, L_lv
    if !curDB.Length
        return
    curIdx := curIdx >= curDB.Length ? 1 : curIdx + 1
    ShowQA(curIdx)
    L_lv.Modify(curIdx,"Select Focus Vis")
}

;@ 經過時間 fx ---UpdateTime()
UpdateTime(){
    global startTick, pauseMs, txtTime
    t := Floor((A_TickCount - startTick - pauseMs) / 1000)
    h := Floor(t / 3600)
    m := Floor(Mod(t, 3600) / 60)
    s := Mod(t, 60)
    txtTime.Value := Format("{:02}:{:02}:{:02}", h, m, s)
}


;@ 發音
;@@ 發音1 ---內建 Microsoft Speech API speakInt()
speakInt(txtEng){
    static sp:=ComObject("SAPI.SpVoice")
    sp.Speak(txtEng, 1)
}  ;speakInt("dominant")

;@@ 發音2a ---googleTTS()
googleTTS(txtEng){
;Run("https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=en&q=" txtEng)
    static wmp := ComObject("WMPlayer.OCX")
    if (Trim(txtEng) = "")
    return
    encodedTxt := UriEncode(txtEng)
    wmp.URL := "https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=en&q=" encodedTxt
    wmp.controls.play()
}


;@@ 發音3 ---世界真人錄音發音humanSp
userSp(txtEng){
    Run("https://forvo.com/word/" txtEng "/")
}




; 發音2b ---googleTTS() input text 轉碼用
UriEncode(str) {
    buf := Buffer(StrPut(str, "UTF-8") - 1)
    StrPut(str, buf, "UTF-8")
    res := ""
    loop buf.Size {
        byte := NumGet(buf, A_Index - 1, "UChar")
        if (byte >= 0x30 && byte <= 0x39) || (byte >= 0x41 && byte <= 0x5A) || (byte >= 0x61 && byte <= 0x7A) || byte = 0x2D || byte = 0x5F || byte = 0x2E || byte = 0x7E
            res .= Chr(byte)
        else
            res .= Format("%{:02X}", byte)
    }
    return res
}




